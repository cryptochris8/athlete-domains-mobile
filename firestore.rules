rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Push notification tokens: users can write their own, Cloud Functions read all
    match /players/{userId}/tokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Purchases subcollection: clients can read, only Cloud Functions can write
    match /players/{userId}/purchases/{purchaseId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only admin SDK (Cloud Functions) can write
    }
    // Leaderboards: anyone authenticated can read, users can only write their own entry
    match /leaderboards/{game}/scores/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
